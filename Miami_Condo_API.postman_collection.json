{
  "info": {
    "name": "Miami Condo API",
    "description": "API endpoints for the Miami Condo backend platform. Structured for a seamless testing flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "neighbourhoodId",
      "value": "",
      "type": "string"
    },
    {
      "key": "developmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "waterfrontId",
      "value": "",
      "type": "string"
    },
    {
      "key": "articleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Neighbourhoods",
      "description": "Run this module first, as Developments and Waterfronts require a Neighbourhood ID.",
      "item": [
        {
          "name": "Create Neighbourhood",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('neighbourhoodId', jsonData.data._id);",
                  "    console.log('Saved neighbourhoodId: ' + jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/neighbourhoods",
              "host": ["{{baseUrl}}"],
              "path": ["neighbourhoods"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brickell\",\n  \"slug\": \"brickell-miami\",\n  \"shortDescription\": \"The financial district of Miami.\",\n  \"fullDescription\": \"Brickell is a dense, high-rise residential neighborhood with many upscale, luxury condominium and apartment towers.\",\n  \"heroImage\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n  \"themeImages\": [\n    { \"url\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\", \"index\": 1 }\n  ],\n  \"amenities\": [\"swimming pool\", \"fitness center\", \"restaurant\"],\n  \"location\": {\n    \"city\": \"Miami\",\n    \"state\": \"FL\",\n    \"country\": \"USA\",\n    \"latitude\": 25.7588,\n    \"longitude\": -80.1916,\n    \"mapEmbedUrl\": \"https://maps.google.com/brickell\"\n  },\n  \"isFeatured\": true\n}"
            }
          }
        },
        {
          "name": "Get All Neighbourhoods",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/neighbourhoods",
              "host": ["{{baseUrl}}"],
              "path": ["neighbourhoods"]
            }
          }
        },
        {
          "name": "Get Neighbourhood By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/neighbourhoods/{{neighbourhoodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["neighbourhoods", "{{neighbourhoodId}}"]
            }
          }
        },
        {
          "name": "Update Neighbourhood",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/neighbourhoods/{{neighbourhoodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["neighbourhoods", "{{neighbourhoodId}}"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isFeatured\": false\n}"
            }
          }
        },
        {
          "name": "Delete Neighbourhood",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/neighbourhoods/{{neighbourhoodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["neighbourhoods", "{{neighbourhoodId}}"]
            }
          }
        }
      ]
    },
